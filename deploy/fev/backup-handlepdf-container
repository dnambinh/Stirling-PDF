#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
[[ $EUID -eq 0 ]] || { echo 'Run: sudo backup-handlepdf-container'; exit 1; }
cd /srv/apps/handlepdf
exec 10>backup.lock
flock 10
base=/srv/backups/handlepdf
install -d -m 700 "$base/daily" "$base/models"
work=$(mktemp -d "$base/daily/.incomplete-XXXXXX")
trap 'rm -rf -- "$work"' EXIT
python3 - "$work/models-manifest.json" <<'PY'
import pathlib,hashlib,json,sys
manifest={}
for name in ['paddlex','paddleocr']:
 root=pathlib.Path('ocr/models')/name
 for p in root.rglob('*'):
  if p.is_file():
   h=hashlib.sha256()
   with p.open('rb') as f:
    for chunk in iter(lambda:f.read(1024*1024),b''):h.update(chunk)
   manifest[str(p)]=h.hexdigest()
pathlib.Path(sys.argv[1]).write_text(json.dumps(manifest,sort_keys=True))
PY
model_sha=$(sha256sum "$work/models-manifest.json" | cut -d' ' -f1)
model_archive="$base/models/$model_sha.tar.gz"
if [[ ! -f $model_archive ]]; then
 tar -I 'gzip -1' -cf "$model_archive.incomplete" ocr/models/paddlex ocr/models/paddleocr
 mv "$model_archive.incomplete" "$model_archive"
fi
# Every daily folder is complete; unchanged models share disk blocks via a hardlink.
ln "$model_archive" "$work/models.tar.gz"
tar -I 'gzip -1' -cf "$work/data.tar.gz" data/configs data/tessdata ocr/models/cache ocr/input ocr/output
for f in compose.yaml compose.deploy.yaml compose.public.yaml core.env ocr.env DEPLOYED_COMMIT PREVIOUS_IMAGES.json runtime-images.json PRODUCTION; do
 [[ ! -f $f ]] || cp "$f" "$work/"
done
(cd "$work" && sha256sum data.tar.gz models.tar.gz models-manifest.json > SHA256SUMS)
final="$base/daily/$(date -u +%Y%m%dT%H%M%SZ)-$$"
mv "$work" "$final"
trap - EXIT
echo "Backup complete: $final (local application backup)"
